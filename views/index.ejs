<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vanua Academy</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <div class="header-content">
            <a href="#" class="logo-link">
                <img src="/images/logo-leaf-cropped.jpg" alt="Vanua Academy Logo" class="logo">
                <h1>Vanua Academy</h1>
            </a>
            <nav class="main-nav">
                <a href="#courses" class="nav-link">Courses</a>
                <a href="#contact" class="nav-link">Contact Us</a>
                <a href="#" class="nav-link">Log In</a>
            </nav>
        </div>
    </header>

    <main>
        <!-- Image Slider -->
        <section class="slider-section">
            <div class="slider-container">
                <div class="slider-wrapper">
                    <!-- Slide 1: Welcome to Vanua Academy -->
                    <div class="slide active">
                        <img src="/images/slider_1.jpg" alt="Welcome to Vanua Academy">
                        <div class="slide-overlay"></div>
                        <div class="slide-content">
                            <h2>Welcome to Vanua Academy</h2>
                            <p>Your premier destination for professional spa and beauty therapy training in the heart of Fiji. We offer comprehensive certification programs designed to launch your career in the wellness and beauty industry.</p>
                        </div>
                    </div>
                    
                    <!-- Slide 2: Contact Us -->
                    <div class="slide">
                        <img src="/images/slider_2.jpg" alt="Contact Us">
                        <div class="slide-overlay"></div>
                        <div class="slide-content">
                            <h2>Get in Touch</h2>
                            <p>We're here to answer your questions and help you start your journey.</p>
                            <a href="#contact" class="slide-button">Contact Us</a>
                        </div>
                    </div>
                    
                    <!-- Slide 3: Student Sign-On -->
                    <div class="slide">
                        <img src="/images/slider_3.jpg" alt="Student Sign-On">
                        <div class="slide-overlay"></div>
                        <div class="slide-content">
                            <h2>Student Portal</h2>
                            <p>Access your courses, assignments, and resources.</p>
                            <a href="#" class="slide-button">Sign In</a>
                        </div>
                    </div>
                </div>
                
                <!-- Navigation Arrows -->
                <button class="slider-arrow slider-arrow-left" aria-label="Previous slide">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15 18l-6-6 6-6"/>
                    </svg>
                </button>
                <button class="slider-arrow slider-arrow-right" aria-label="Next slide">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 18l6-6-6-6"/>
                    </svg>
                </button>
                
                <!-- Pagination Dots -->
                <div class="slider-dots">
                    <span class="dot active" data-slide="0"></span>
                    <span class="dot" data-slide="1"></span>
                    <span class="dot" data-slide="2"></span>
                </div>
            </div>
        </section>

        <section class="courses" id="courses">
            <div class="container">
                <h2>Our Courses</h2>
                <% if (!isFiji) { %>
                    <p class="international-notice">International students are subject to an additional fee. All prices shown include this fee.</p>
                <% } %>
                <div class="courses-grid">
                    <% courses.forEach((course, index) => { %>
                        <div class="course-card">
                            <div class="course-number"><%= index + 1 %></div>
                            <h3><%= course.name %></h3>
                            <p class="course-duration"><%= course.duration %></p>
                            <p class="course-price">
                                <%= formatCurrency(course.price, course.currency) %>
                            </p>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>



        <section class="contact" id="contact">
            <div class="container">
                <h2>Contact Us</h2>
                <div class="contact-wrapper">
                    <div class="contact-map">
                        <img src="/images/Fiji-map.png" alt="Fiji Map showing location of Vanua Academy in Savusavu">
                    </div>
                    <div class="contact-info">
                        <div class="contact-item">
                            <strong>Location</strong>
                            <p><%= location %></p>
                        </div>
                        <div class="contact-item">
                            <strong>Email</strong>
                            <p><a href="mailto:<%= email %>"><%= email %></a></p>
                        </div>
                        <div class="contact-item">
                            <strong>Phone</strong>
                            <p><a href="tel:<%= phone %>"><%= phone %></a></p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> Vanua Academy. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/slider.js"></script>
</body>
</html>

